# Copier en .env.local (dev) et dans Vercel → Settings → Environment Variables (prod)

# Clés VAPID : générer une fois avec  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact.ideaforma@gmail.com

# Base Upstash Redis (Vercel → Storage → Upstash → Redis, plan gratuit)
# (Vercel → Storage crée KV_REST_API_URL / KV_REST_API_TOKEN, prioritaires)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mot de passe du cron (chaîne longue au hasard) : cron-job.org appelle chaque minute
# https://<ton-domaine>/api/push/envoyer  avec l'en-tête  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ===== Assistant IA + soutien (Stripe, Resend, Anthropic) =====
STRIPE_SECRET_KEY=sk_live_...
RESEND_API_KEY=re_...
IA_EMAIL_EXPEDITEUR="My Easy Coran <assistant@myeasycoran.fr>"
ANTHROPIC_API_KEY=sk-ant-...
IA_MODELE=claude-sonnet-4-5
NEXT_PUBLIC_URL_SITE=https://www.myeasycoran.fr
NEXT_PUBLIC_LIEN_ABONNEMENT_IA=https://buy.stripe.com/...
NEXT_PUBLIC_LIEN_SOUTIEN=https://buy.stripe.com/...

# ===== Récitation (quiz vocal) =====
OPENAI_API_KEY=sk-...                      # transcription Whisper (facturée à l'utilisateur via les crédits)
NEXT_PUBLIC_LIEN_CREDITS_RECITATION=https://buy.stripe.com/...   # paiement unique 2 €, redirection /api/recitation/acces?session_id={CHECKOUT_SESSION_ID}
