# Copier en .env.local (dev) et dans Vercel → Settings → Environment Variables (prod)

# Clés VAPID : générer une fois avec  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact.ideaforma@gmail.com

# Base Upstash Redis (Vercel → Storage → Upstash → Redis, plan gratuit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mot de passe du cron (chaîne longue au hasard) : cron-job.org appelle chaque minute
# https://<ton-domaine>/api/push/envoyer  avec l'en-tête  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
